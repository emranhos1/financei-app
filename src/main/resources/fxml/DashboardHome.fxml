<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.finance.controller.DashboardHomeController"
            fitToWidth="true" styleClass="dash-scroll">
<VBox styleClass="content-pane" spacing="7">

    <Label text="Financial Summary" styleClass="page-title"/>

    <!-- Row 1: account type balance cards, built dynamically in controller -->
    <HBox fx:id="balanceCardsBox" spacing="8"/>

    <!-- Row 2: Net worth (50%) | Recent transactions (50%) -->
    <GridPane hgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox styleClass="dash-summary-card" spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Net worth" styleClass="dash-section-title"/>
            <Label text="Liquid balance — bank and cash type accounts" styleClass="dash-section-hint"/>
            <Label fx:id="netWorthAmountLabel" text="৳ 0.00" styleClass="dash-networth-amount"/>
            <FlowPane fx:id="netWorthChipsBox" hgap="8" vgap="8"/>
        </VBox>

        <VBox styleClass="dash-summary-card" spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Recent transactions" styleClass="dash-section-title"/>
            <VBox fx:id="recentTxBox" spacing="0"/>
        </VBox>
    </GridPane>

    <!-- Row 3: Income vs expense last 7 days (50%) | Expense ratio + top expense (50%) -->
    <GridPane hgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox styleClass="dash-summary-card" spacing="3" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Income vs expense — last 7 days" styleClass="dash-section-title"/>
            <HBox spacing="14">
                <Label fx:id="weeklyNetLabel" text="৳ 0.00 net" styleClass="dash-trend-amount"/>
                <Region HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Region styleClass="dash-legend-dot-income"/>
                    <Label text="Income" styleClass="dash-legend-label"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Region styleClass="dash-legend-dot-expense"/>
                    <Label text="Expense" styleClass="dash-legend-label"/>
                </HBox>
            </HBox>
            <HBox fx:id="weeklyChartBox" spacing="8" alignment="BOTTOM_CENTER" prefHeight="65">
                <padding><Insets top="4"/></padding>
            </HBox>
        </VBox>

        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <VBox styleClass="dash-summary-card" spacing="3" alignment="CENTER">
                <StackPane fx:id="expenseRingStack" prefWidth="54" prefHeight="54" maxWidth="54" maxHeight="54">
                    <Label fx:id="expenseRingLabel" text="0%" styleClass="dash-ring-label"/>
                </StackPane>
                <Label text="Expense of this month's income" styleClass="dash-ring-sub" wrapText="true"
                       alignment="CENTER" textAlignment="CENTER" maxWidth="140"/>
            </VBox>
            <VBox styleClass="dash-summary-card" spacing="2">
                <Label text="Top expense" styleClass="dash-top-expense-label"/>
                <Label fx:id="topExpenseLabel" text="—" styleClass="dash-top-expense-value" wrapText="true"/>
            </VBox>
        </VBox>
    </GridPane>

    <!-- Row 4: Net worth trend (60%) | Today / Month / Year table (40%) -->
    <GridPane hgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="60"/>
            <ColumnConstraints percentWidth="40"/>
        </columnConstraints>

        <VBox styleClass="dash-summary-card" spacing="3" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <HBox>
                <Label text="Net worth trend" styleClass="dash-section-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Label fx:id="trendAmountLabel" text="৳ 0.00" styleClass="dash-trend-amount"/>
            </HBox>
            <StackPane fx:id="trendChartPane" prefHeight="40" minHeight="40"/>
            <HBox fx:id="trendMonthLabelsBox" spacing="4"/>
        </VBox>

        <VBox styleClass="dash-summary-card" spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Today / Month / Year" styleClass="dash-section-title"/>
            <GridPane hgap="14" vgap="3">
                <Label text="" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="Income" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="dash-table-head"/>
                <Label text="Expense" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="dash-table-head"/>

                <Label text="Today" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="dash-card-label"/>
                <Label fx:id="todayIncomeLabel" text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label fx:id="todayExpenseLabel" text="৳ 0.00" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                <Label text="Month" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="dash-card-label"/>
                <Label fx:id="monthIncomeLabel" text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label fx:id="monthExpenseLabel" text="৳ 0.00" GridPane.columnIndex="2" GridPane.rowIndex="2"/>

                <Label text="Year" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="dash-card-label"/>
                <Label fx:id="yearIncomeLabel" text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label fx:id="yearExpenseLabel" text="৳ 0.00" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
            </GridPane>
        </VBox>
    </GridPane>

    <!-- Row 5: Goal accounts (60%) | Category Breakdown (40%) -->
    <GridPane hgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="60"/>
            <ColumnConstraints percentWidth="40"/>
        </columnConstraints>

        <VBox styleClass="dash-summary-card" spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <HBox>
                <Label text="Goal accounts" styleClass="dash-section-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Label text="Shows any account with a maturity date" styleClass="dash-section-hint"/>
            </HBox>
            <FlowPane fx:id="goalCardsBox" hgap="8" vgap="8"/>
        </VBox>

        <VBox styleClass="dash-summary-card" spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Category Breakdown" styleClass="dash-card-title"/>
            <ComboBox fx:id="categoryComboBox" prefWidth="300" promptText="— Select Category —"/>

            <GridPane hgap="20" vgap="3">
                <Label text=""           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="Income"     GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="dash-card-title"/>
                <Label text="Expense"    GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="dash-card-title"/>

                <Label text="Today"      GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="dash-card-label"/>
                <Label fx:id="catTodayIncLabel" text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label fx:id="catTodayExpLabel" text="৳ 0.00" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                <Label text="This Month" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="dash-card-label"/>
                <Label fx:id="catMonthIncLabel" text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label fx:id="catMonthExpLabel" text="৳ 0.00" GridPane.columnIndex="2" GridPane.rowIndex="2"/>

                <Label text="This Year"  GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="dash-card-label"/>
                <Label fx:id="catYearIncLabel" text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label fx:id="catYearExpLabel" text="৳ 0.00" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
            </GridPane>
        </VBox>
    </GridPane>

</VBox>
</ScrollPane>
