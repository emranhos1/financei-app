<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.finance.controller.DashboardHomeController"
            fitToWidth="true" styleClass="dash-scroll">
<VBox styleClass="content-pane" spacing="7">

    <Label text="Financial Summary" styleClass="page-title"/>

    <HBox fx:id="loanReminderBanner" alignment="CENTER_LEFT" spacing="8" styleClass="dash-loan-toast" visible="false" managed="false">
        <Label text="⚠" style="-fx-font-size: 14;"/>
        <Label fx:id="loanReminderLabel" text="" wrapText="true" HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox fx:id="maturityReminderBanner" alignment="CENTER_LEFT" spacing="8" styleClass="dash-loan-toast" visible="false" managed="false">
        <Label text="⚠" style="-fx-font-size: 14;"/>
        <Label fx:id="maturityReminderLabel" text="" wrapText="true" HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox fx:id="lowBalanceReminderBanner" alignment="CENTER_LEFT" spacing="8" styleClass="dash-loan-toast" visible="false" managed="false">
        <Label text="⚠" style="-fx-font-size: 14;"/>
        <Label fx:id="lowBalanceReminderLabel" text="" wrapText="true" HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Row 1: account type balance cards, built dynamically in controller -->
    <HBox fx:id="balanceCardsBox" spacing="8"/>

    <!-- Row 2: Net worth (24%) | Recent transactions (24%) | Expense%/Top expense (24%) | Expense Breakdown (28%) -->
    <GridPane hgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="24" minWidth="10"/>
            <ColumnConstraints percentWidth="24" minWidth="10"/>
            <ColumnConstraints percentWidth="24" minWidth="10"/>
            <ColumnConstraints percentWidth="28" minWidth="10"/>
        </columnConstraints>

        <VBox styleClass="dash-summary-card" spacing="2" minWidth="0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Net worth" styleClass="dash-section-title"/>
            <Label text="Liquid balance — bank and cash type accounts" styleClass="dash-section-hint" wrapText="true"/>
            <Label fx:id="netWorthAmountLabel" text="৳ 0.00" styleClass="dash-networth-amount"/>
            <FlowPane fx:id="netWorthChipsBox" hgap="8" vgap="4"/>
        </VBox>

        <VBox styleClass="dash-summary-card" spacing="2" minWidth="0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Recent transactions" styleClass="dash-section-title"/>
            <VBox fx:id="recentTxBox" spacing="0"/>
        </VBox>

        <VBox styleClass="dash-summary-card" spacing="3" minWidth="0" GridPane.columnIndex="2" GridPane.rowIndex="0">
            <VBox spacing="1" alignment="CENTER">
                <Label text="Expense % of Income" styleClass="dash-ring-sub" wrapText="true"
                       alignment="CENTER" textAlignment="CENTER" maxWidth="140"/>
                <StackPane fx:id="expenseRingStack" prefWidth="46" prefHeight="46" maxWidth="46" maxHeight="46">
                    <Label fx:id="expenseRingLabel" text="0%" styleClass="dash-ring-label"/>
                </StackPane>
                <Label text="MONTHLY" styleClass="dash-section-hint"/>
            </VBox>

            <Separator/>

            <VBox spacing="0">
                <Label text="Top expense" styleClass="dash-top-expense-label"/>
                <Label fx:id="topExpenseLabel" text="—" styleClass="dash-top-expense-value" wrapText="true"/>
                <Label text="(BANK + CASH)" styleClass="dash-section-hint"/>
            </VBox>
        </VBox>

        <VBox styleClass="dash-summary-card" spacing="2" minWidth="0" GridPane.columnIndex="3" GridPane.rowIndex="0">
            <Label text="Expense Breakdown" styleClass="dash-section-title"/>
            <PieChart fx:id="dashExpensePieChart" minWidth="0" minHeight="130" prefHeight="130"
                      labelsVisible="true" legendVisible="false"/>
        </VBox>
    </GridPane>

    <!-- Loans given: who still owes me and how much, built dynamically in controller -->
    <VBox fx:id="loansGivenCard" styleClass="dash-summary-card" spacing="4">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Loans given — outstanding" styleClass="dash-section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="loansGivenTotalLabel" text="৳ 0.00" styleClass="dash-networth-amount"/>
        </HBox>
        <!-- one tile per person, 4 per row, built dynamically in controller -->
        <GridPane fx:id="loansGivenBox" hgap="8" vgap="8">
            <columnConstraints>
                <ColumnConstraints percentWidth="25" minWidth="10"/>
                <ColumnConstraints percentWidth="25" minWidth="10"/>
                <ColumnConstraints percentWidth="25" minWidth="10"/>
                <ColumnConstraints percentWidth="25" minWidth="10"/>
            </columnConstraints>
        </GridPane>
    </VBox>

    <!-- Row 3: Monthly Expense — Cash (50%) | Monthly Expense — Bank (50%) -->
    <GridPane hgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox styleClass="dash-summary-card" spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Monthly Expense — Cash" styleClass="dash-section-title"/>
            <Label text="Sum of EXPENSE transactions paid from your Cash-type accounts, per month. Income and Transfers are not counted. Click ✎ next to a month to manually save/correct its actual figure — a saved value overrides the calculated one."
                   styleClass="dash-section-hint" wrapText="true"/>
            <VBox fx:id="cashMonthlyExpenseBox" spacing="1"/>
        </VBox>

        <VBox styleClass="dash-summary-card" spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Monthly Expense — Bank" styleClass="dash-section-title"/>
            <Label text="Sum of EXPENSE transactions paid from your Bank-type accounts, per month. Income and Transfers are not counted. Click ✎ next to a month to manually save/correct its actual figure — a saved value overrides the calculated one."
                   styleClass="dash-section-hint" wrapText="true"/>
            <VBox fx:id="bankMonthlyExpenseBox" spacing="1"/>
        </VBox>
    </GridPane>

</VBox>
</ScrollPane>