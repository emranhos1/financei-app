<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.controller.DashboardHomeController"
      styleClass="content-pane">

    <Label text="Financial Summary" styleClass="page-title"/>

    <!-- Balance cards built dynamically in controller -->
    <HBox fx:id="balanceCardsBox" spacing="12"/>

    <!-- Period cards: Today | This Month | This Year -->
    <HBox spacing="12">

        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="Today" styleClass="card-title"/>
            <HBox spacing="10">
                <Label text="Income:"  styleClass="card-label"/>
                <Label fx:id="todayIncomeLabel" text="৳ 0.00"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Expense:" styleClass="card-label"/>
                <Label fx:id="todayExpenseLabel" text="৳ 0.00"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Net:" styleClass="card-label"/>
                <Label fx:id="todayNetLabel" text="৳ 0.00" styleClass="net-label"/>
            </HBox>
        </VBox>

        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="This Month" styleClass="card-title"/>
            <HBox spacing="10">
                <Label text="Income:"  styleClass="card-label"/>
                <Label fx:id="monthIncomeLabel" text="৳ 0.00"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Expense:" styleClass="card-label"/>
                <Label fx:id="monthExpenseLabel" text="৳ 0.00"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Net:" styleClass="card-label"/>
                <Label fx:id="monthNetLabel" text="৳ 0.00" styleClass="net-label"/>
            </HBox>
        </VBox>

        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS" spacing="6">
            <Label text="This Year" styleClass="card-title"/>
            <HBox spacing="10">
                <Label text="Income:"  styleClass="card-label"/>
                <Label fx:id="yearIncomeLabel" text="৳ 0.00"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Expense:" styleClass="card-label"/>
                <Label fx:id="yearExpenseLabel" text="৳ 0.00"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Net:" styleClass="card-label"/>
                <Label fx:id="yearNetLabel" text="৳ 0.00" styleClass="net-label"/>
            </HBox>
        </VBox>

    </HBox>

    <!-- Category breakdown -->
    <VBox styleClass="summary-card" spacing="10">
        <Label text="Category Breakdown" styleClass="card-title"/>
        <ComboBox fx:id="categoryComboBox" prefWidth="300" promptText="— Select Category —"/>

        <GridPane hgap="24" vgap="8">
            <Label text=""           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text="Income"     GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="card-title"/>
            <Label text="Expense"    GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="card-title"/>

            <Label text="Today"      GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="card-label"/>
            <Label fx:id="catTodayIncLabel" text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label fx:id="catTodayExpLabel" text="৳ 0.00" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

            <Label text="This Month" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="card-label"/>
            <Label fx:id="catMonthIncLabel" text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label fx:id="catMonthExpLabel" text="৳ 0.00" GridPane.columnIndex="2" GridPane.rowIndex="2"/>

            <Label text="This Year"  GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="card-label"/>
            <Label fx:id="catYearIncLabel" text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Label fx:id="catYearExpLabel" text="৳ 0.00" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
        </GridPane>
    </VBox>

</VBox>
