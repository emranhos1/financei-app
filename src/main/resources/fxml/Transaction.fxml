<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.controller.TransactionController"
      spacing="10" style="-fx-padding: 15;">

    <TabPane VBox.vgrow="ALWAYS">

        <Tab text="Record Transaction" closable="false">
            <HBox spacing="15" style="-fx-padding: 10;">

                <VBox spacing="8" prefWidth="270">

                    <Label text="Date"/>
                    <DatePicker fx:id="datePicker" maxWidth="Infinity"/>

                    <Label text="Type"/>
                    <HBox spacing="15">
                        <RadioButton fx:id="incomeRadio" text="INCOME">
                            <toggleGroup><ToggleGroup fx:id="typeToggleGroup"/></toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="expenseRadio" text="EXPENSE" toggleGroup="$typeToggleGroup"/>
                    </HBox>

                    <Label text="Account"/>
                    <ComboBox fx:id="accountComboBox" maxWidth="Infinity"/>
                    <Label fx:id="accountBalanceLabel" text="" style="-fx-font-size: 11; -fx-text-fill: #4F6F66;"/>

                    <Label text="Category"/>
                    <ComboBox fx:id="categoryComboBox" maxWidth="Infinity"/>

                    <Label text="Amount"/>
                    <TextField fx:id="amountField" promptText="0.00" maxWidth="Infinity"/>

                    <Label text="Note"/>
                    <TextArea fx:id="noteArea" prefHeight="60" wrapText="true" maxWidth="Infinity"/>

                    <Button fx:id="saveTransactionBtn" text="Save Transaction"
                            onAction="#handleSaveTransaction" maxWidth="Infinity" styleClass="btn-primary"/>

                    <HBox fx:id="txEditButtons" spacing="8" visible="false" managed="false">
                        <Button text="Update" onAction="#handleUpdateTransaction" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-primary"/>
                        <Button text="Delete" onAction="#handleDeleteTransaction" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-accent"/>
                        <Button text="Cancel" onAction="#handleCancelTransaction" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-secondary"/>
                    </HBox>

                </VBox>

                <VBox spacing="6" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Category:"/>
                        <ComboBox fx:id="categoryFilterComboBox" prefWidth="180"/>
                        <Label text="Date:"/>
                        <DatePicker fx:id="dateFilter" prefWidth="140"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Account:"/>
                        <ComboBox fx:id="accountFilterComboBox" prefWidth="180"/>
                        <Label text="Type:"/>
                        <ComboBox fx:id="typeFilterComboBox" prefWidth="140"/>
                        <Button text="Clear" onAction="#handleClearFilters" styleClass="btn-secondary"/>
                    </HBox>

                    <TableView fx:id="transactionsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="dateColumn"     text="Date"     prefWidth="95"/>
                            <TableColumn fx:id="typeColumn"     text="Type"     prefWidth="80"/>
                            <TableColumn fx:id="accountColumn"  text="Account"  prefWidth="140"/>
                            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="120"/>
                            <TableColumn fx:id="amountColumn"   text="Amount"   prefWidth="90"/>
                            <TableColumn fx:id="noteColumn"     text="Note"     minWidth="150"/>
                        </columns>
                        <placeholder><Label text="No transactions yet"/></placeholder>
                    </TableView>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button fx:id="txPrevPageBtn" text="◀ Prev" onAction="#handleTxPrevPage" styleClass="btn-secondary"/>
                        <Label fx:id="txPageLabel" text="Page 1 of 1"/>
                        <Button fx:id="txNextPageBtn" text="Next ▶" onAction="#handleTxNextPage" styleClass="btn-secondary"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Rows per page:"/>
                        <ComboBox fx:id="txPageSizeComboBox" prefWidth="80"/>
                    </HBox>
                </VBox>

            </HBox>
        </Tab>

        <Tab text="Categories" closable="false">
            <HBox spacing="15" style="-fx-padding: 10;">

                <VBox spacing="8" prefWidth="260">
                    <Label text="Category Name"/>
                    <TextField fx:id="catNameField" promptText="e.g. Salary, Food"/>

                    <Label text="Type"/>
                    <ComboBox fx:id="catTypeComboBox" maxWidth="Infinity"/>

                    <Button fx:id="catAddBtn" text="Add Category" onAction="#handleAddCategory" maxWidth="Infinity" styleClass="btn-primary"/>

                    <HBox fx:id="catEditButtons" spacing="8" managed="false" visible="false">
                        <Button text="Update" onAction="#handleUpdateCategory" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-primary"/>
                        <Button text="Delete" onAction="#handleDeleteCategory" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-accent"/>
                        <Button text="Cancel" onAction="#handleCancelCategory" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>

                <TableView fx:id="categoriesTable" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="catIdColumn"   text="ID"   prefWidth="60"/>
                        <TableColumn fx:id="catNameColumn" text="Name" prefWidth="180"/>
                        <TableColumn fx:id="catTypeColumn" text="Type" prefWidth="100"/>
                    </columns>
                    <placeholder><Label text="No categories yet. Add some!"/></placeholder>
                </TableView>

            </HBox>
        </Tab>

    </TabPane>
</VBox>
