<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.controller.TransactionController"
      spacing="10" style="-fx-padding: 15;">

    <Label text="Transactions" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <TabPane VBox.vgrow="ALWAYS">

        <!-- ===== TAB 1: Record Transaction ===== -->
        <Tab text="Record Transaction" closable="false">
            <HBox spacing="15" style="-fx-padding: 10;">

                <VBox spacing="8" prefWidth="270">
                    <Label text="Type"/>
                    <ComboBox fx:id="typeComboBox" prefWidth="250"/>

                    <Label text="Date"/>
                    <DatePicker fx:id="datePicker" prefWidth="250"/>

                    <Label text="Account"/>
                    <ComboBox fx:id="accountComboBox" prefWidth="250"/>

                    <Label text="Category"/>
                    <ComboBox fx:id="categoryComboBox" prefWidth="250"/>

                    <Label text="Amount"/>
                    <TextField fx:id="amountField" promptText="0.00"/>

                    <Label text="Note"/>
                    <TextArea fx:id="noteArea" prefHeight="60" wrapText="true"/>

                    <HBox spacing="8">
                        <Button text="Save"   onAction="#handleSaveTransaction" prefWidth="80"/>
                        <Button text="Delete" onAction="#handleDeleteTransaction" prefWidth="80"/>
                        <Button text="Clear"  onAction="#handleClearForm" prefWidth="80"/>
                    </HBox>
                </VBox>

                <TableView fx:id="transactionsTable" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn"       text="ID"       prefWidth="50"/>
                        <TableColumn fx:id="dateColumn"     text="Date"     prefWidth="95"/>
                        <TableColumn fx:id="typeColumn"     text="Type"     prefWidth="75"/>
                        <TableColumn fx:id="accountColumn"  text="Account"  prefWidth="130"/>
                        <TableColumn fx:id="categoryColumn" text="Category" prefWidth="110"/>
                        <TableColumn fx:id="amountColumn"   text="Amount"   prefWidth="100"/>
                    </columns>
                    <placeholder><Label text="No transactions yet"/></placeholder>
                </TableView>
            </HBox>
        </Tab>

        <!-- ===== TAB 2: Categories ===== -->
        <Tab text="Categories" closable="false">
            <HBox spacing="15" style="-fx-padding: 10;">

                <VBox spacing="8" prefWidth="260">
                    <Label text="Category Name"/>
                    <TextField fx:id="catNameField" promptText="e.g. Salary, Food"/>

                    <Label text="Type"/>
                    <ComboBox fx:id="catTypeComboBox" maxWidth="Infinity"/>

                    <!-- Add: shown by default -->
                    <Button fx:id="catAddBtn" text="Add Category" onAction="#handleAddCategory" maxWidth="Infinity"/>

                    <!-- Update/Delete/Cancel: hidden by default -->
                    <HBox fx:id="catEditButtons" spacing="8" managed="false" visible="false">
                        <Button text="Update" onAction="#handleUpdateCategory" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Delete" onAction="#handleDeleteCategory" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Cancel" onAction="#handleCancelCategory" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>

                <TableView fx:id="categoriesTable" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="catIdColumn"   text="ID"   prefWidth="60"/>
                        <TableColumn fx:id="catNameColumn" text="Name" prefWidth="180"/>
                        <TableColumn fx:id="catTypeColumn" text="Type" prefWidth="100"/>
                    </columns>
                    <placeholder><Label text="No categories yet. Add some!"/></placeholder>
                </TableView>
            </HBox>
        </Tab>

    </TabPane>
</VBox>
