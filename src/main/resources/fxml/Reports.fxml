<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.controller.ReportsController"
      spacing="10" style="-fx-padding: 15;">

    <Label text="Financial Reports" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <HBox spacing="10" style="-fx-alignment: CENTER-LEFT;">
        <Label text="Start:"/>
        <DatePicker fx:id="startDatePicker" prefWidth="140"/>
        <Label text="End:"/>
        <DatePicker fx:id="endDatePicker" prefWidth="140"/>
        <Button text="Generate" onAction="#handleGenerateReport" styleClass="btn-primary"/>
    </HBox>

    <VBox style="-fx-border-color: #B7D9CE; -fx-padding: 10; -fx-background-color: #ffffff;">
        <GridPane hgap="30" vgap="8">
            <Label text="Total Income:"  GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label fx:id="totalIncomeLabel"  text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <Label text="Total Expense:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="totalExpenseLabel" text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <Label text="Net Income:"    GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label fx:id="netIncomeLabel"    text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
        </GridPane>
    </VBox>

    <HBox spacing="10" VBox.vgrow="NEVER">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Expense by Category" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
            <TableView fx:id="expenseCategoryTable" minHeight="120" prefHeight="120">
                <columns>
                    <TableColumn fx:id="expCategoryNameColumn"   text="Category" prefWidth="160"/>
                    <TableColumn fx:id="expCategoryAmountColumn" text="Amount"   prefWidth="120"/>
                </columns>
                <placeholder><Label text="No data"/></placeholder>
            </TableView>
        </VBox>

        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Income by Category" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
            <TableView fx:id="incomeCategoryTable" minHeight="120" prefHeight="120">
                <columns>
                    <TableColumn fx:id="incCategoryNameColumn"   text="Category" prefWidth="160"/>
                    <TableColumn fx:id="incCategoryAmountColumn" text="Amount"   prefWidth="120"/>
                </columns>
                <placeholder><Label text="No data"/></placeholder>
            </TableView>
        </VBox>

        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Account Balances" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
            <TableView fx:id="accountTable" minHeight="120" prefHeight="120">
                <columns>
                    <TableColumn fx:id="accountNameColumn"    text="Account" prefWidth="120"/>
                    <TableColumn fx:id="accountTypeColumn"    text="Type"    prefWidth="80"/>
                    <TableColumn fx:id="accountBalanceColumn" text="Balance" prefWidth="110"/>
                </columns>
                <placeholder><Label text="No accounts"/></placeholder>
            </TableView>
        </VBox>
    </HBox>

    <HBox spacing="10" style="-fx-alignment: CENTER-LEFT;">
        <Label text="Account Log" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
        <ComboBox fx:id="accountLogComboBox" prefWidth="200" promptText="View account log"/>
        <Label text="Export:"/>
        <ComboBox fx:id="accountLogFilterComboBox" prefWidth="180" promptText="All Accounts"/>
        <Button text="Export CSV" onAction="#handleExportCSV" styleClass="btn-secondary"/>
    </HBox>

    <TableView fx:id="accountLogTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="logDateColumn"          text="Date"          prefWidth="100"/>
            <TableColumn fx:id="logChangeTypeColumn"    text="Change"        prefWidth="85"/>
            <TableColumn fx:id="logRefTypeColumn"       text="Reference"     prefWidth="85"/>
            <TableColumn fx:id="logAmountColumn"        text="Amount"        prefWidth="100"/>
            <TableColumn fx:id="logBalanceBeforeColumn" text="Before"        prefWidth="110"/>
            <TableColumn fx:id="logBalanceAfterColumn"  text="After"         prefWidth="110"/>
            <TableColumn fx:id="logNoteColumn"          text="Note"          minWidth="150"/>
        </columns>
        <placeholder><Label text="Select an account to view its log"/></placeholder>
    </TableView>

</VBox>
