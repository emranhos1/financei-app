<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.finance.controller.DashboardController"
            fx:id="mainBorderPane">

    <left>
        <VBox fx:id="sidebarVBox" style="-fx-border-color: #cccccc; -fx-padding: 10; -fx-spacing: 10;"
              prefWidth="150">
            <Button fx:id="dashboardBtn" text="Dashboard" style="-fx-pref-width: 130; -fx-padding: 10;"/>
            <Button fx:id="accountsBtn" text="Accounts" style="-fx-pref-width: 130; -fx-padding: 10;"/>
            <Button fx:id="transactionBtn" text="Transactions" style="-fx-pref-width: 130; -fx-padding: 10;"/>
            <Button fx:id="transferBtn" text="Transfer" style="-fx-pref-width: 130; -fx-padding: 10;"/>
            <Button fx:id="reportsBtn" text="Reports" style="-fx-pref-width: 130; -fx-padding: 10;"/>
            <Button fx:id="adminBtn" text="Admin Panel" style="-fx-pref-width: 130; -fx-padding: 10;"/>
            <Button fx:id="logoutBtn" text="Logout" style="-fx-pref-width: 130; -fx-padding: 10;"/>
        </VBox>
    </left>

    <center>
        <!-- Content loaded dynamically -->
    </center>
</BorderPane>
